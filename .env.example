# ==============================================================================
# IntelliBase - AI Knowledge Base Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT commit your actual .env file with real secrets to version control.
# ==============================================================================

# Database Connection (PostgreSQL with pgvector enabled)
# For cloud providers like Render, Supabase, Neon, or Railway:
# format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/ai_knowledge_base

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Security
# Generate a strong 32+ character random secret string (e.g., via `openssl rand -hex 32`)
SECRET_KEY=generate_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment & Security Controls
# Options: development, production
ENVIRONMENT=production

# Disable Swagger & OpenAPI interactive documentation in production for security/privacy
SHOW_DOCS=false

# Database Query Logging (keep 'false' in production so sensitive data is never logged)
DB_ECHO=false
